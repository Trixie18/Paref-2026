# Copy the backend section below to backend/.env and fill in real values.
# Never commit the filled-in version. The frontend (frontend/) is a plain
# static site with no build step, so it has no .env file — its equivalent
# settings are constants at the top of frontend/assets/js/auth.js and
# frontend/assets/js/api.js (see frontend/README.md).

# ---- Backend: repository & auth backend selection --------------------------
# "memory" = in-process store, no Google credentials needed (local dev/tests).
# "google_sheets" = the real Google Spreadsheet backend.
REPOSITORY_BACKEND=memory

# "dev" accepts fake "Bearer dev:<uid>" tokens and must NEVER be used in
# production. "firebase" verifies real Firebase ID tokens.
AUTH_BACKEND=dev

# When true and REPOSITORY_BACKEND=memory, the backend seeds development
# data (parents, players, products, bundles, sample orders) on startup.
SEED_ON_STARTUP=true

# The football event's year, used as the prefix for generated order IDs
# (e.g. ORD-2026-000001).
EVENT_YEAR=2026

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5500

# Requests allowed per client IP per rolling minute (best-effort, in-process
# only — see app/core/rate_limit.py).
RATE_LIMIT_PER_MINUTE=600

# ---- Google Sheets (required when REPOSITORY_BACKEND=google_sheets) --------
GOOGLE_SHEET_ID=
# Path to the downloaded service account JSON key file.
GOOGLE_SERVICE_ACCOUNT=./service-account.json

# ---- Firebase Admin SDK (required when AUTH_BACKEND=firebase) --------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Frontend Firebase web app config ---------------------------------
# Not read from this file — the frontend has no build step to inject env
# vars. Set these as constants directly in frontend/assets/js/auth.js
# (FIREBASE_API_KEY, FIREBASE_AUTH_DOMAIN, FIREBASE_PROJECT_ID,
# FIREBASE_APP_ID) when switching AUTH_MODE to "firebase" there. The
# backend base URL the frontend calls is the API_BASE_URL constant at the
# top of frontend/assets/js/api.js (default http://localhost:8000).
